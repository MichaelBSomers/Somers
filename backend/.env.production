# Backend Production Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=production

# Database Configuration (MongoDB Atlas or production DB)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/somers_prod
DB_NAME=somers_prod

# JWT Secret (use a secure random string)
JWT_SECRET=your-production-jwt-secret-key
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=https://your-production-domain.com

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# Logging
LOG_LEVEL=error

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
SECURE_COOKIES=true
TRUST_PROXY=true
