# Development Environment Variables
VITE_APP_TITLE=Somers App - Development
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_TIMEOUT=10000

# Feature Flags
VITE_ENABLE_DEBUG=true
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_DEVTOOLS=true

# Analytics & Monitoring (disabled in dev)
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Database (if using local DB)
VITE_DB_HOST=localhost
VITE_DB_PORT=5432
VITE_DB_NAME=somers_dev

# Third-party Services (dev keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_dev_stripe_key
VITE_MAPBOX_ACCESS_TOKEN=pk.dev_mapbox_token

# Logging
VITE_LOG_LEVEL=debug
