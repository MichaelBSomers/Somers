# Production Environment Variables
VITE_APP_TITLE=Somers App
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production

# API Configuration
VITE_API_BASE_URL=https://api.somersapp.com/api
VITE_API_TIMEOUT=30000

# Feature Flags
VITE_ENABLE_DEBUG=false
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_DEVTOOLS=false

# Analytics & Monitoring
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Database
VITE_DB_HOST=your-production-db-host
VITE_DB_PORT=5432
VITE_DB_NAME=somers_prod

# Third-party Services (production keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_production_stripe_key
VITE_MAPBOX_ACCESS_TOKEN=pk.production_mapbox_token

# Logging
VITE_LOG_LEVEL=error

# Security
VITE_ENABLE_HTTPS=true
VITE_SECURE_COOKIES=true
