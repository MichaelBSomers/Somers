# Local Environment Variables (not committed to git)
# Copy this file to .env.local and fill in your actual values

# Development overrides
VITE_API_BASE_URL=http://localhost:3001/api
VITE_APP_TITLE=My Awesome App
VITE_APP_ENV=development

# Local database connection
VITE_DB_USER=your_username
VITE_DB_PASSWORD=your_password

# Local API keys (get these from respective services)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_actual_dev_key
VITE_MAPBOX_ACCESS_TOKEN=pk.your_actual_dev_token

# Local feature flags
VITE_ENABLE_DEBUG=true
VITE_ENABLE_MOCK_DATA=false

# Developer-specific settings
VITE_DEVELOPER_NAME=Your Name
VITE_LOCAL_PORT=5175

# Access environment variables in your components
const apiUrl = import.meta.env.VITE_API_BASE_URL;
const appTitle = import.meta.env.VITE_APP_TITLE;
const isDebug = import.meta.env.VITE_ENABLE_DEBUG === 'true';

// Example usage
console.log(`App running in ${import.meta.env.VITE_APP_ENV} mode`);
